classDiagram
    class Owner {
        +String owner_id
        +String name
        +String email
        +List~Pet~ pets
        +add_pet(pet: Pet)
        +remove_pet(pet_id: String)
        +get_pets() List~Pet~
        +get_all_tasks() List~Task~
    }

    class Pet {
        +String pet_id
        +String name
        +String species
        +Float age
        +String special_instructions
        +List~Task~ tasks
        +add_task(task: Task)
        +update_profile(...)
        +get_details() Dict
    }

    class Task {
        +String task_id
        +String pet_id
        +String title
        +Int duration
        +Priority priority
        +String scheduled_time
        +Boolean is_completed
        +String recurrence
        +mark_complete()
        +update_task_details(...)
    }

    class Priority {
        <<enumeration>>
        LOW = 1
        MEDIUM = 2
        HIGH = 3
        CRITICAL = 4
    }

    class Plan {
        +List~Task~ scheduled
        +List~Task~ skipped
        +Int remaining_minutes
        +Dict skip_reasons
    }

    class Scheduler {
        +generate_daily_plan(owner: Owner, time_limit_minutes: Int) Plan
        +sort_tasks_by_priority(tasks: List~Task~) List~Task~
        +detect_conflicts(tasks: List~Task~) List~Tuple~
    }

    Owner "1" *-- "many" Pet : owns
    Pet "1" *-- "many" Task : has
    Task --> Priority : uses
    Scheduler ..> Plan : returns
    Scheduler ..> Owner : processes
